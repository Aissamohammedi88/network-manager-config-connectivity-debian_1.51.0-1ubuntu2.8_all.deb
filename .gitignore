# ==========================================
# 🐧 COUSIN DEBIAN MANAGER — .gitignore
# ==========================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/

# --- Système d'exploitation / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Fichiers de l'application ---
# On ignore l'archive générée (elle doit être dans les "Releases", pas dans le code)
*.tar.gz
*.zip
*.deb

# On ignore le fichier de données du livre d'or (données locales)
tributes.json
# Mais on garde un modèle vide pour les nouveaux utilisateurs
!tributes.example.json

# --- Logs & temporaires ---
*.log
server.out
nohup.out
